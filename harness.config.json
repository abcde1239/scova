{
    "schemaVersion": 1,
    "repository": {
        "visibility": "private"
    },
    "workspaces": [
        {
            "root": ".",
            "id": "root"
        },
        {
            "root": "apps/web",
            "id": "apps-web",
            "tests": {
                "requireConfiguredTask": true
            }
        },
        {
            "root": "tests/e2e",
            "id": "web-shell-e2e",
            "tests": {
                "include": ["**/*.spec.ts"],
                "requireConfiguredTask": false
            }
        },
        {
            "root": "apps/server",
            "tests": {
                "requireConfiguredTask": true
            },
            "id": "apps-server"
        },
        {
            "root": "apps/worker",
            "id": "apps-worker",
            "tests": {
                "requireConfiguredTask": true
            }
        },
        {
            "root": "packages/models",
            "id": "packages-models",
            "tests": {
                "requireConfiguredTask": true
            }
        },
        {
            "root": "packages/db",
            "id": "packages-db",
            "tests": {
                "requireConfiguredTask": true
            }
        },
        {
            "root": "packages/agent-core",
            "id": "packages-agent-core",
            "tests": {
                "requireConfiguredTask": true
            }
        },
        {
            "root": "packages/connectors",
            "id": "packages-connectors",
            "tests": {
                "requireConfiguredTask": true
            }
        },
        {
            "root": "packages/shared",
            "tests": {
                "requireConfiguredTask": true
            },
            "id": "packages-shared"
        }
    ],
    "documents": {
        "defaultAudience": "internal",
        "publicRoots": ["docs/public"],
        "internalRoots": [
            "docs/overall",
            "docs/prd",
            "docs/decision",
            "docs/verification",
            ".harness",
            ".agents",
            ".codex"
        ],
        "publicPatterns": [
            "README.md",
            "swagger.json",
            "AGENTS.md",
            ".gitignore",
            "package.json",
            "pnpm-lock.yaml",
            "pnpm-workspace.yaml",
            "tsconfig.json",
            "vite.config.ts",
            "harness.config.json",
            ".vite-hooks/pre-commit",
            ".vscode/settings.json",
            ".vscode/extensions.json",
            "apps/**",
            "packages/**",
            "scripts/**",
            ".github/workflows/**",
            "compose.yaml",
            "compose.search.yaml",
            "ops/searxng/**",
            "Dockerfile",
            ".dockerignore",
            ".env.example",
            "tests/**",
            "compose.test.yaml",
            ".gitattributes",
            "ops/proxy/**"
        ],
        "internalPatterns": [
            "docs/structure.md",
            "docs/agent_guide.md",
            "docs/*-prd.md",
            "**/MEMORY.md",
            "**/memory/**",
            "**/memories/**",
            "**/decision/**",
            "**/decisions/**",
            "**/.env",
            "**/.env.local",
            "**/.env.*.local",
            "**/.env.production",
            "**/.env.development",
            "**/.env.test",
            "**/.env.staging",
            "**/node_modules/**",
            "**/dist/**",
            "**/coverage/**",
            "**/artifacts/**",
            "backups/**"
        ]
    },
    "tests": {
        "include": ["**/*.test.ts", "**/*.spec.ts"],
        "exclude": [
            "node_modules/**",
            "dist/**",
            "artifacts/**",
            "coverage/**",
            "scripts/vendor/**",
            "compose.test.yaml",
            "**/.generated/**"
        ],
        "artifacts": ["artifacts", "coverage"],
        "requireConfiguredTask": false
    },
    "tasks": [
        {
            "id": "web-report-questions-browser",
            "workspace": "web-shell-e2e",
            "kind": "test",
            "argv": ["vp", "run", "test:e2e", "tests/e2e/report-questions.spec.ts"],
            "covers": ["web-shell-e2e"],
            "timeoutMs": 180000,
            "cwd": ".",
            "required": false,
            "enabled": false
        },
        {
            "id": "web-report-browser",
            "workspace": "web-shell-e2e",
            "kind": "test",
            "argv": ["vp", "run", "test:e2e", "tests/e2e/report.spec.ts"],
            "covers": ["web-shell-e2e"],
            "timeoutMs": 180000,
            "cwd": ".",
            "required": false,
            "enabled": false
        },
        {
            "id": "web-shell-browser",
            "workspace": "web-shell-e2e",
            "kind": "test",
            "argv": ["vp", "run", "test:e2e", "--", "tests/e2e/shell.spec.ts"],
            "covers": ["web-shell-e2e"],
            "timeoutMs": 180000,
            "cwd": ".",
            "required": false,
            "enabled": false
        },
        {
            "id": "static-check",
            "workspace": "root",
            "kind": "lint",
            "argv": ["vp", "check"],
            "timeoutMs": 120000,
            "cwd": ".",
            "dependsOn": [],
            "required": true,
            "enabled": true,
            "covers": ["root"]
        },
        {
            "id": "unit-tests",
            "workspace": "root",
            "kind": "test",
            "argv": ["vp", "test"],
            "covers": [
                "apps-web",
                "apps-server",
                "apps-worker",
                "packages-shared",
                "packages-models",
                "packages-agent-core",
                "packages-connectors"
            ],
            "timeoutMs": 120000,
            "cwd": ".",
            "dependsOn": [],
            "required": true,
            "enabled": true
        },
        {
            "id": "workspace-build",
            "workspace": "root",
            "kind": "build",
            "argv": ["vp", "run", "-r", "build"],
            "timeoutMs": 120000,
            "cwd": ".",
            "dependsOn": [],
            "required": true,
            "enabled": true,
            "covers": ["root"]
        },
        {
            "id": "runtime-bun",
            "timeoutMs": 180000,
            "workspace": "root",
            "kind": "test",
            "covers": ["root"],
            "argv": ["vp", "run", "test:runtime"]
        },
        {
            "id": "connectors-runtime",
            "workspace": "root",
            "kind": "test",
            "covers": ["packages-connectors"],
            "timeoutMs": 60000,
            "argv": ["vp", "run", "test:connectors:runtime"]
        },
        {
            "id": "runtime-node",
            "timeoutMs": 180000,
            "workspace": "root",
            "kind": "test",
            "covers": ["root"],
            "argv": ["vp", "run", "test:runtime:node"]
        },
        {
            "id": "api-openapi",
            "workspace": "root",
            "argv": ["vp", "run", "api:openapi:check"],
            "covers": ["root"],
            "timeoutMs": 120000,
            "kind": "lint"
        },
        {
            "id": "api-processes",
            "workspace": "root",
            "argv": ["vp", "run", "test:processes"],
            "covers": ["apps-server"],
            "timeoutMs": 120000,
            "kind": "test"
        },
        {
            "id": "backend-integration",
            "workspace": "root",
            "argv": ["vp", "run", "test:integration"],
            "covers": ["apps-server", "apps-worker", "packages-db"],
            "timeoutMs": 900000,
            "kind": "test"
        },
        {
            "id": "web-execution-browser",
            "workspace": "web-shell-e2e",
            "kind": "test",
            "argv": [
                "vp",
                "exec",
                "playwright",
                "test",
                "--config",
                "tests/e2e/execution.config.ts"
            ],
            "covers": ["web-shell-e2e"],
            "timeoutMs": 180000,
            "cwd": ".",
            "required": false,
            "enabled": false
        }
    ],
    "publicationTargets": [],
    "rules": {
        "tests.layout": "error",
        "tests.configured": "error",
        "tests.artifacts": "error",
        "documents.links": "error",
        "tasks.graph": "error"
    },
    "baseline": []
}
