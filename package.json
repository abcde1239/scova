{
  "name": "scova",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "search:up": "vpx scripts/searxng.ts up",
    "search:down": "vpx scripts/searxng.ts down",
    "search:status": "vpx scripts/searxng.ts status",
    "test:search:live": "vpx scripts/smoke-search.ts --live",
    "test:search:read": "vpx scripts/smoke-search.ts --live --read",
    "test:connectors:tavily": "vpx scripts/smoke-connectors.ts --live --provider=tavily",
    "test:connectors:runtime": "vpx scripts/connectors-runtime.ts && vpx scripts/run-bun.mjs scripts/connectors-runtime.ts",
    "test:connectors:live": "vpx scripts/smoke-connectors.ts --live",
    "test:connectors:reader": "vpx scripts/smoke-connectors.ts --reader-only",
    "ready": "vp run harness-verify",
    "harness-lint": "vpx scripts/harness.mjs lint",
    "harness-verify": "vpx scripts/harness.mjs verify",
    "dev": "vp run web#dev",
    "prepare": "vp config",
    "test:processes": "vpx scripts/smoke-processes.mjs",
    "test:runtime": "vpx scripts/run-bun.mjs scripts/runtime-test.mjs",
    "test:runtime:node": "vpx scripts/runtime-test.mjs",
    "api:openapi": "vpx scripts/generate-openapi.mjs",
    "api:openapi:check": "vpx scripts/generate-openapi.mjs --check",
    "test:database": "vp test --config tests/database.vite.config.ts",
    "test:auth": "vp test --config tests/auth.vite.config.ts",
    "test:integration": "vp run test:database && vp run test:auth && vp test --config tests/tasks.vite.config.ts && vp run test:task-drafts && vp test --config tests/runs.vite.config.ts && vp run test:reports && vp run test:library && vp test --config tests/backend-flow.vite.config.ts && vp run test:worker",
    "test:library": "vp test --config tests/library.vite.config.ts",
    "test:task-drafts": "vp test --config tests/task-drafts.vite.config.ts",
    "test:reports": "vp test --config tests/reports.vite.config.ts",
    "test:delivery": "vp test --config tests/worker-outbox.vite.config.ts apps/worker/tests/delivery.integration.test.ts",
    "test:worker": "vp test --config tests/worker-outbox.vite.config.ts",
    "test:agent-recovery": "vp test --config tests/worker-outbox.vite.config.ts apps/worker/tests/recovery.integration.test.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@langchain/langgraph-checkpoint-postgres": "catalog:",
    "@prisma/client": "catalog:",
    "@scova/utils": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "prisma": {
    "schema": "packages/models/prisma/schema.prisma"
  }
}
