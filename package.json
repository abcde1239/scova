{
    "name": "scova",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vpx --env-file-if-exists=.env.local scripts/check-dev.ts && vp run -r --parallel dev",
        "dev:frontend": "vp run web#dev",
        "dev:server": "vp run server#dev",
        "dev:worker": "vp run worker#dev",
        "build": "vp run -r build",
        "build:frontend": "vp run web#build",
        "build:server": "vp run server#build",
        "build:worker": "vp run worker#build",
        "build:e2e": "vp run web#build:e2e",
        "preview": "vp run preview:frontend",
        "preview:frontend": "vp run web#preview",
        "local:init": "vpx scripts/local.ts init",
        "local:up": "vpx scripts/local.ts up",
        "local:down": "vpx scripts/local.ts down",
        "local:status": "vpx scripts/local.ts status",
        "db:migrate": "vpx --env-file-if-exists=.env.local scripts/run-bun.mjs --cwd apps/server src/operations.ts migrate",
        "db:migrate:node": "vpx --env-file-if-exists=.env.local apps/server/src/operations.ts migrate",
        "search:up": "vpx scripts/searxng.ts up",
        "search:down": "vpx scripts/searxng.ts down",
        "search:status": "vpx scripts/searxng.ts status",
        "operations": "node scripts/operations.mjs",
        "api:openapi": "vpx scripts/generate-openapi.mjs",
        "api:openapi:check": "vpx scripts/generate-openapi.mjs --check",
        "ready": "vp run harness-verify",
        "verify:web": "vpx scripts/verify-web.mjs",
        "verify:web:browser": "vpx scripts/verify-web.mjs --browser-only",
        "verify:web:failure": "vpx scripts/verify-web.mjs --controlled-failure",
        "verify:mvp-full": "vpx scripts/verify-mvp-full.mjs",
        "verify:mvp:browser": "vpx scripts/verify-mvp-full.mjs --supplementary-only",
        "harness-lint": "vpx scripts/harness.mjs lint",
        "harness-verify": "vpx scripts/harness.mjs verify",
        "prepare": "vp config"
    },
    "dependencies": {
        "@js-temporal/polyfill": "catalog:",
        "@langchain/langgraph": "catalog:",
        "@langchain/langgraph-checkpoint-postgres": "catalog:",
        "@scova/db": "workspace:*",
        "@scova/execution": "workspace:*",
        "@scova/shared": "workspace:*",
        "bullmq": "catalog:",
        "drizzle-orm": "catalog:",
        "ioredis": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@playwright/test": "catalog:",
        "@scova/models": "workspace:*",
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "vite-plus": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.15.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
