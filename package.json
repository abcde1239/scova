{
  "name": "scova",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run harness-verify",
    "harness-lint": "vpx scripts/harness.mjs lint",
    "harness-verify": "vpx scripts/harness.mjs verify",
    "dev": "vp run web#dev",
    "prepare": "vp config",
    "test:processes": "vpx scripts/smoke-processes.mjs",
    "test:runtime": "vpx scripts/run-bun.mjs scripts/runtime-test.mjs",
    "test:runtime:node": "vpx scripts/runtime-test.mjs",
    "api:openapi": "vpx scripts/generate-openapi.mjs",
    "api:openapi:check": "vpx scripts/generate-openapi.mjs --check",
    "test:database": "vp test --config tests/database.vite.config.ts",
    "test:auth": "vp test --config tests/auth.vite.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@langchain/langgraph-checkpoint-postgres": "catalog:",
    "@prisma/client": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "prisma": {
    "schema": "packages/models/prisma/schema.prisma"
  }
}
