# Dedicated single-host database; URL-encode credentials if changed.
POSTGRES_PASSWORD=replace_with_a_random_database_password
APP_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=/api/v1
SCOVA_BIND=127.0.0.1
SCOVA_PORT=8080
REGISTRATION_ENABLED=true
# Queue is shared by the API publisher, Worker consumer and maintenance tools.
WORKER_QUEUE_NAME=scova-runs
# Internal Server–Worker identity. Generate 32 random bytes as hex.
WORKER_EXECUTION_TOKEN=
# Per Worker instance; 1–32. Raise only after measuring queue and resource use.
WORKER_RUN_CONCURRENCY=2
# All new manual, retry and scheduled runs use live research; missing configuration fails explicitly.
# Search service, credentials and Reader policy are configured in each account.
# Transport-only DNS policy; does not select a search provider.
SEARCH_DNS_RESOLVER=auto
SEARCH_ENGINE_INTERVAL_MS=10000
SEARCH_CONFIG_VERSION=1
SEARCH_CACHE_ENABLED=true
SEARCH_ADAPTIVE_ENABLED=true
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_DNS_RESOLVER=auto
READER_DNS_RESOLVER=auto
# Extra time for JavaScript-rendered articles; shares the fixed 15-second read deadline (1..5000).
READER_RENDER_WAIT_MS=1000
# 64 hex digits, used by Server only. Preserve across upgrades and backups.
AGENT_CREDENTIAL_KEY=
SEARXNG_SECRET=replace_with_a_random_search_secret
# Optional one-round supplementation of core answer gaps; consumes the existing repair budget.
RESEARCH_ANSWER_SUPPLEMENT_ENABLED=false

# Optional avatar and large report attachment bucket (r2 or s3). API credentials only.
# 通用R2/S3存储，兼容整组旧IMAGE_STORAGE_*配置
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_JURISDICTION=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SESSION_TOKEN=
