{
    "name": "@scova/db",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./feedback": "./src/feedback.ts",
        "./migrate": "./src/migrate.ts",
        "./sqlite-state": "./src/sqlite-state.ts"
    },
    "scripts": {
