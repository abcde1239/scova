model ReportQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  reportId      String   @map("report_id") @db.Uuid
  question      String
  answerJson    Json?    @map("answer_json")
  followupRunId String?  @map("followup_run_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner       User               @relation("User_ReportQuestion", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  report      Report             @relation("ReportQuestion_report", fields: [userId, reportId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  followupRun Run?               @relation("ReportQuestion_followupRun", fields: [userId, followupRunId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
