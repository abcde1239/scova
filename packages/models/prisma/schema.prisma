  @@unique([userId, id])
  @@map("report_questions")
}

model QuestionEvidence {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid

  owner    User           @relation("User_QuestionEvidence", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question ReportQuestion @relation("QuestionEvidence_question", fields: [userId, questionId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  evidence Evidence       @relation("QuestionEvidence_evidence", fields: [userId, evidenceId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, id])
  @@unique([questionId, evidenceId])
  @@map("question_evidence")
}
