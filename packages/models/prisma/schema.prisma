  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  owner  User    @relation("User_Notification", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run    Run     @relation("Notification_run", fields: [userId, runId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  report Report? @relation("Notification_report", fields: [userId, runId, reportId], references: [userId, runId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, id])
