  claimId   String?      @map("claim_id") @db.Uuid
  kind      FeedbackKind
  active    Boolean      @default(true)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner  User    @relation("User_Feedback", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task   Task    @relation("Feedback_task", fields: [userId, taskId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  source Source? @relation("Feedback_source", fields: [userId, sourceId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  claim  Claim?  @relation("Feedback_claim", fields: [userId, taskId, claimId], references: [userId, taskId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, id])
  @@map("feedback")
}

model Bookmark {
