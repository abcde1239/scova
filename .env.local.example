# Host development: PostgreSQL / Redis / SearXNG run in compose.local.yaml.
# vp run local:init generates random secrets and writes the ignored .env.local.
POSTGRES_PASSWORD=replace_with_a_random_database_password
SCOVA_LOCAL_PG_PORT=15432
SCOVA_LOCAL_REDIS_PORT=16379
SCOVA_SEARXNG_PORT=18080
DATABASE_URL=postgresql://scova:replace_with_a_random_database_password@127.0.0.1:15432/scova
REDIS_URL=redis://127.0.0.1:16379
SEARXNG_BASE_URL=http://127.0.0.1:18080
SEARXNG_SECRET=replace_with_a_random_search_secret

# Exact browser origin allowed by the API. Requests go directly to VITE_API_BASE_URL.
APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
PORT=3000
REGISTRATION_ENABLED=true
AGENT_CHECKPOINT_SCHEMA=scova_agent
AGENT_CHECKPOINT_MIGRATION=startup
WORKER_QUEUE_NAME=scova-local-runs
SEARCH_PROVIDER=searxng

# Configure a personal provider in the account UI, or set deployment defaults below for research.
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_DNS_RESOLVER=auto
READER_DNS_RESOLVER=auto
# Encryption key for account-owned API keys; local:init creates it once. Back it up.
AGENT_CREDENTIAL_KEY=
TAVILY_API_KEY=
