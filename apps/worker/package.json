{
    "name": "worker",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/main.ts",
        "dev:node": "vpx --watch --env-file-if-exists=.env src/node.ts",
        "start": "bun run src/main.ts",
        "start:node": "vpx --env-file-if-exists=.env src/node.ts",
        "build": "tsc --noEmit",
        "test": "vp test",
        "check": "vp check"
    },
    "dependencies": {
        "@langchain/core": "catalog:",
        "@langchain/langgraph-checkpoint-postgres": "catalog:",
        "@scova/agent-core": "workspace:*",
        "@scova/connectors": "workspace:*",
        "@scova/db": "workspace:*",
        "@scova/models": "workspace:*",
        "@scova/shared": "workspace:*",
        "bullmq": "catalog:",
        "ioredis": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "typescript": "catalog:"
    }
}
