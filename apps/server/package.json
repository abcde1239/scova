{
    "name": "server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vpx ../../scripts/run-bun.mjs --env-file=../../.env.local --watch src/main.ts",
        "dev:node": "vpx --env-file-if-exists=../../.env.local --watch src/node.ts",
        "start": "vpx ../../scripts/run-bun.mjs run src/main.ts",
        "start:node": "vpx src/node.ts",
        "build": "tsc --noEmit",
        "test": "vp test",
        "check": "vp check"
    },
    "dependencies": {
        "@elysiajs/node": "catalog:",
        "@elysiajs/swagger": "^1.2.1",
        "@langchain/langgraph-checkpoint-postgres": "catalog:",
        "@node-rs/argon2": "catalog:",
        "@scova/connectors": "workspace:*",
        "@scova/db": "workspace:*",
        "@scova/models": "workspace:*",
        "@scova/object-storage": "workspace:*",
        "@scova/shared": "workspace:*",
        "bullmq": "catalog:",
        "elysia": "^1.4.7",
        "ioredis": "catalog:",
        "pg": "catalog:",
        "sharp": "catalog:",
        "srvx": "0.11.22"
    },
    "devDependencies": {
        "@types/bun": "^1.2.0",
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "typescript": "catalog:"
    }
}
