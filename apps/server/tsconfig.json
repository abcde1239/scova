{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "paths": { "@/*": ["./src/*"] },
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["tests"]
}
